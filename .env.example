# ─────────────────────────────────────────────────────────────────────────────
# Variant Sync Tool — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Shopify Store domain
SHOPIFY_STORE=urbandeco.myshopify.com

# From Shopify Partner Dashboard → your app → App settings → Client ID & Secret
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here

# Scopes needed
SCOPES=read_products,write_products

# The URL where this app is hosted (no trailing slash)
# Local:  http://localhost:3000
# Render: https://your-app-name.onrender.com
APP_URL=http://localhost:3000

# Port (Render sets this automatically, leave as 3000 for local)
PORT=3000
